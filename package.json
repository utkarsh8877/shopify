{
  "name": "shopify-clone",
  "version": "1.0.0",
  "description": "MERN Stack E-Commerce App",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seed.js",
    "data:destroy": "node backend/seed.js -d",
    "build": "npm install && npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend"
  },
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5"
  }
}
